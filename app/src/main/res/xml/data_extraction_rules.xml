<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup + Device-to-device transfer rules (Android API 31+).

  Both sections preserve the user's contributions DB and DataStore
  preferences. The canonical book DB (compendium.db) is intentionally
  omitted because it is regenerable from bundled assets on first
  launch, and including it would burn the 25 MB Auto Backup quota.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="contributions.db" />
        <include domain="file" path="datastore/compendium_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="contributions.db" />
        <include domain="file" path="datastore/compendium_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
