CREATE TABLE ability_listing (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

-- listing_id / effect_id columns are soft refs: their lifecycle is managed in
-- Kotlin by Default*Repository (cascade on delete/upsert) and audited at
-- runtime by IntegritySweep. Declared REFERENCES would not have been enforced
-- anyway -- SQLite requires PRAGMA foreign_keys = ON per connection and the
-- AndroidSqliteDriver doesn't set it -- so we dropped them at v7 (migration
-- 6.sqm) to stop misleading future readers. Re-enabling real FK enforcement
-- is tracked in TODO.md (Engineering section) and requires a pre-migration
-- orphan scrub before flipping the pragma.
CREATE TABLE ability_effect (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    listing_id INTEGER NOT NULL,
    rank TEXT NOT NULL,
    type TEXT NOT NULL,
    cooldown_seconds INTEGER NOT NULL,
    description TEXT NOT NULL,
    replacement_key TEXT,
    ordinal INTEGER NOT NULL
);

CREATE TABLE effect_property (
    effect_id INTEGER NOT NULL,
    property TEXT NOT NULL,
    ordinal INTEGER NOT NULL
);

CREATE TABLE effect_cost (
    effect_id INTEGER NOT NULL,
    kind TEXT NOT NULL,
    amount TEXT NOT NULL,
    resource TEXT NOT NULL,
    ordinal INTEGER NOT NULL
);

insertAbilityListing:
INSERT INTO ability_listing(name) VALUES (?);

selectAbilityListingId:
SELECT id FROM ability_listing WHERE name = ?;

updateAbilityListingName:
UPDATE ability_listing SET name = ? WHERE id = ?;

deleteAbilityListingById:
DELETE FROM ability_listing WHERE id = ?;

deleteEffectsForListing:
DELETE FROM ability_effect WHERE listing_id = ?;

insertAbilityEffect:
INSERT INTO ability_effect(listing_id, rank, type, cooldown_seconds, description, replacement_key, ordinal)
VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

insertEffectProperty:
INSERT INTO effect_property(effect_id, property, ordinal) VALUES (?, ?, ?);

insertEffectCost:
INSERT INTO effect_cost(effect_id, kind, amount, resource, ordinal) VALUES (?, ?, ?, ?, ?);

selectAllAbilityListings:
SELECT id, name FROM ability_listing;

selectAllAbilityEffects:
SELECT * FROM ability_effect ORDER BY listing_id, ordinal;

selectAllEffectProperties:
SELECT * FROM effect_property ORDER BY effect_id, ordinal;

selectAllEffectCosts:
SELECT * FROM effect_cost ORDER BY effect_id, ordinal;

selectEffectIdsForListing:
SELECT id FROM ability_effect WHERE listing_id = ?;

deleteEffectPropertiesForEffect:
DELETE FROM effect_property WHERE effect_id = ?;

deleteEffectCostsForEffect:
DELETE FROM effect_cost WHERE effect_id = ?;

deleteAllEffectCosts:
DELETE FROM effect_cost;

deleteAllEffectProperties:
DELETE FROM effect_property;

deleteAllAbilityEffects:
DELETE FROM ability_effect;

deleteAllAbilityListings:
DELETE FROM ability_listing;

updateEffectDescription:
UPDATE ability_effect SET description = ? WHERE id = ?;

selectEffectsWithStatusTokens:
SELECT id, description FROM ability_effect WHERE description LIKE '%{status:%';
