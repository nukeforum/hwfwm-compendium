CREATE TABLE awakening_stone (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    rarity TEXT NOT NULL
);

insertAwakeningStone:
INSERT INTO awakening_stone(name, rarity) VALUES (?, ?);

selectAwakeningStoneId:
SELECT id FROM awakening_stone WHERE name = ?;

updateAwakeningStoneName:
UPDATE awakening_stone SET name = ? WHERE id = ?;

deleteAwakeningStoneById:
DELETE FROM awakening_stone WHERE id = ?;

selectAllAwakeningStones:
SELECT id, name, rarity FROM awakening_stone;

deleteAllAwakeningStones:
DELETE FROM awakening_stone;
