CREATE TABLE manifestation (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    rarity TEXT NOT NULL,
    description TEXT NOT NULL,
    is_restricted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE confluence (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    is_restricted INTEGER NOT NULL DEFAULT 0
);

-- confluence_id is a soft ref: see the note in AbilityListings.sq above. FK
-- enforcement is off on this driver, so the declared REFERENCES never bit;
-- dropped at v7 to stop misleading readers. Kotlin-side cascade lives in
-- EssenceDatabase.deleteConfluenceById.
CREATE TABLE confluence_set (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    confluence_id INTEGER NOT NULL,
    essence1_ref TEXT NOT NULL,
    essence2_ref TEXT NOT NULL,
    essence3_ref TEXT NOT NULL,
    is_restricted INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_confluence_set_essence1_ref ON confluence_set(essence1_ref);
CREATE INDEX idx_confluence_set_essence2_ref ON confluence_set(essence2_ref);
CREATE INDEX idx_confluence_set_essence3_ref ON confluence_set(essence3_ref);

insertManifestation:
INSERT INTO manifestation(name, rarity, description, is_restricted) VALUES (?, ?, ?, ?);

selectManifestationId:
SELECT id FROM manifestation WHERE name = ?;

updateManifestationName:
UPDATE manifestation SET name = ? WHERE id = ?;

updateManifestationFully:
UPDATE manifestation SET name = ?, rarity = ?, description = ?, is_restricted = ? WHERE id = ?;

deleteManifestationById:
DELETE FROM manifestation WHERE id = ?;

insertConfluence:
INSERT INTO confluence(name, is_restricted) VALUES (?, ?);

selectConfluenceId:
SELECT id FROM confluence WHERE name = ?;

updateConfluenceName:
UPDATE confluence SET name = ?, is_restricted = ? WHERE id = ?;

deleteConfluenceById:
DELETE FROM confluence WHERE id = ?;

insertConfluenceSet:
INSERT INTO confluence_set(confluence_id, essence1_ref, essence2_ref, essence3_ref, is_restricted)
VALUES (?, ?, ?, ?, ?);

selectAllManifestations:
SELECT id, name, rarity, description, is_restricted FROM manifestation;

selectAllConfluences:
SELECT id, name, is_restricted FROM confluence;

selectAllConfluenceSets:
SELECT id, confluence_id, essence1_ref, essence2_ref, essence3_ref, is_restricted FROM confluence_set;

deleteConfluenceSetsForConfluence:
DELETE FROM confluence_set WHERE confluence_id = ?;

deleteAllConfluenceSets:
DELETE FROM confluence_set;

deleteAllConfluences:
DELETE FROM confluence;

deleteAllManifestations:
DELETE FROM manifestation;

selectConfluenceSetsReferencingEssenceRef:
SELECT DISTINCT confluence.name
FROM confluence_set
INNER JOIN confluence ON confluence_set.confluence_id = confluence.id
WHERE confluence_set.essence1_ref = ?
   OR confluence_set.essence2_ref = ?
   OR confluence_set.essence3_ref = ?;

lastInsertRowId:
SELECT last_insert_rowid();
