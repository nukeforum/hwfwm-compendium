CREATE TABLE status_effect (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    type TEXT NOT NULL,
    stackable INTEGER NOT NULL,
    description TEXT NOT NULL,
    properties TEXT NOT NULL
);

insertStatusEffect:
INSERT INTO status_effect(name, type, stackable, description, properties) VALUES (?, ?, ?, ?, ?);

selectStatusEffectId:
SELECT id FROM status_effect WHERE name = ?;

updateStatusEffectName:
UPDATE status_effect SET name = ? WHERE id = ?;

deleteStatusEffectById:
DELETE FROM status_effect WHERE id = ?;

selectAllStatusEffects:
SELECT id, name, type, stackable, description, properties FROM status_effect;

deleteAllStatusEffects:
DELETE FROM status_effect;

lastInsertRowId:
SELECT last_insert_rowid();

updateStatusEffectFully:
UPDATE status_effect SET name = ?, type = ?, stackable = ?, description = ?, properties = ? WHERE id = ?;
